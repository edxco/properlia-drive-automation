{
  "name": "properlia-automatizacion",
  "version": "0.1.0",
  "private": true,
  "description": "Properlia - automatización documental en Google Apps Script (entorno TEST)",
  "scripts": {
    "env:test": "node scripts/use-env.js test",
    "status:test": "node scripts/use-env.js test && clasp status",
    "push:test": "npm test && node scripts/use-env.js test && clasp push",
    "pull:test": "node scripts/use-env.js test && clasp pull",
    "check": "node scripts/check-syntax.js",
    "test": "node scripts/check-syntax.js && node --test tests/unit/*.test.js",
    "docs:keys": "node scripts/build-key-docs.js",
    "docs:check": "node scripts/build-key-docs.js --check"
  },
  "engines": {
    "node": ">=18"
  }
}
